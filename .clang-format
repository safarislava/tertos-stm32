---
Language: Cpp
BasedOnStyle: LLVM

# STM32CubeMX / HAL Style (2 spaces, no tabs)
UseTab: Never
IndentWidth: 2
TabWidth: 2
ContinuationIndentWidth: 2
IndentCaseLabels: false
AccessModifierOffset: -2

# Line width
ColumnLimit: 120

# Braces (Allman style - opening braces on a new line)
BreakBeforeBraces: Allman
AllowShortBlocksOnASingleLine: Never
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false

# Pointers & References
PointerAlignment: Right

# Spaces
SpaceBeforeParens: ControlStatements
SpaceAfterCStyleCast: false
SpaceInEmptyParentheses: false
SpacesInParentheses: false
SpacesInSquareBrackets: false
SpacesInAngles: false
# Comments (Preserve STM32CubeMX comment formatting and Doxygen blocks)
ReflowComments: false
AlignTrailingComments: false
SpacesBeforeTrailingComments: 1

# Includes (Do not reorder headers to prevent FreeRTOS/HAL dependency issues)
SortIncludes: Never

# Empty lines & block padding (CubeMX retains empty lines at start of blocks)
MaxEmptyLinesToKeep: 2
KeepEmptyLinesAtTheStartOfBlocks: true
AlignConsecutiveAssignments: false
AlignConsecutiveDeclarations: false
AlignOperands: Align

Standard: Latest
...
